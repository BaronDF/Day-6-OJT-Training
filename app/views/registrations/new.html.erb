
<div class="flex min-h-[75vh] items-center justify-center px-6 py-12">

  <div class="w-full max-w-md rounded-2xl border border-slate-800 bg-slate-900 p-8 shadow-2xl">

    <!-- Heading -->
    <div class="mb-8 text-center">
      <h1 class="text-3xl font-bold text-white">
        Create Account
      </h1>

      <p class="mt-2 text-sm text-slate-400">
        Join us and start organizing your tasks
      </p>
    </div>

    <!-- Registration Form -->
    <%= form_with model: @user, url: registrations_path, class: "space-y-5" do |form| %>

      <!-- Validation Errors -->
      <% if @user.errors.any? %>
        <div class="rounded-xl border border-red-800 bg-red-900/30 p-4 text-sm text-red-300">
          <p class="mb-2 font-semibold">Please correct these errors:</p>
          <ul class="list-disc space-y-1 pl-5">
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <!-- Full Name -->
      <div>
        <%= form.label :name, "Full Name",
            class: "mb-2 block text-sm font-semibold text-slate-200" %>

        <%= form.text_field :name,
            required: true,
            autocomplete: "name",
            placeholder: "Enter your full name",
            class: "block w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-3 text-white placeholder-slate-500 outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500" %>
      </div>

      <!-- Email -->
      <div>
        <%= form.label :email_address, "Email Address",
            class: "mb-2 block text-sm font-semibold text-slate-200" %>

        <%= form.email_field :email_address,
            required: true,
            autocomplete: "email",
            placeholder: "Enter your email address",
            class: "block w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-3 text-white placeholder-slate-500 outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500" %>
      </div>

      <!-- Password -->
      <div>
        <%= form.label :password, "Password",
            class: "mb-2 block text-sm font-semibold text-slate-200" %>

        <%= form.password_field :password,
            required: true,
            autocomplete: "new-password",
            placeholder: "Create a password",
            class: "block w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-3 text-white placeholder-slate-500 outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500" %>
      </div>

      <!-- Password Confirmation -->
      <div>
        <%= form.label :password_confirmation, "Confirm Password",
            class: "mb-2 block text-sm font-semibold text-slate-200" %>

        <%= form.password_field :password_confirmation,
            required: true,
            autocomplete: "new-password",
            placeholder: "Confirm your password",
            class: "block w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-3 text-white placeholder-slate-500 outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-500" %>
      </div>

      <!-- Submit -->
      <%= form.submit "Create Account",
          class: "w-full cursor-pointer rounded-xl bg-sky-600 px-5 py-3 font-bold text-white transition hover:bg-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-400 focus:ring-offset-2 focus:ring-offset-slate-900" %>

    <% end %>

    <!-- Login Link -->
    <div class="mt-8 border-t border-slate-800 pt-6 text-center">
      <p class="text-sm text-slate-400">
        Already have an account?
        <%= link_to "Sign In", new_session_path,
            class: "font-semibold text-sky-400 hover:text-sky-300" %>
      </p>
    </div>

  </div>

</div>
