
<% content_for :title, "My Tasks" %>

<div class="min-h-screen bg-slate-950 px-6 py-10 text-slate-100">
  <div class="mx-auto max-w-5xl">

    <header class="mb-10 flex items-center justify-between">
      <h1 class="text-3xl font-bold text-white">
        My Task Manager
      </h1>

      <%= link_to "New Task", new_task_path,
          class: "rounded-lg bg-sky-600 px-5 py-3 font-semibold text-white shadow transition hover:bg-sky-500" %>
    </header>

    <section class="mb-8 rounded-2xl border border-slate-800 bg-slate-900 p-8 shadow-sm">
      <h2 class="mb-2 text-2xl font-bold text-white">
        Welcome Back, <%= Current.user.name.presence || "there" %>!
      </h2>

      <p class="text-slate-400">
        Organize your work and keep track of your progress.
      </p>
    </section>

    <% if notice.present? %>
      <p class="mb-5 rounded-lg bg-green-900 p-4 text-green-300">
        <%= notice %>
      </p>
    <% end %>

    <section>
      <h2 class="mb-5 text-xl font-bold text-white">
        Your Tasks
      </h2>

      <div id="tasks" class="grid gap-5 md:grid-cols-2">
        <% @tasks.each do |task| %>
          <div class="rounded-xl border border-slate-800 bg-slate-900 p-6 shadow-sm transition hover:border-slate-700">

            <%= render task %>

            <div class="mt-5 border-t border-slate-700 pt-4">
              <%= link_to "View Task", task,
                  class: "font-semibold text-sky-400 hover:text-sky-300" %>
            </div>

          </div>
        <% end %>
      </div>

      <% if @tasks.empty? %>
        <div class="rounded-xl border border-slate-800 bg-slate-900 p-10 text-center">
          <p class="text-slate-400">
            No tasks yet. Create your first task!
          </p>
        </div>
      <% end %>
    </section>

  </div>
</div>
