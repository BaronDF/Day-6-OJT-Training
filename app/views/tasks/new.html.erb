
<% content_for :title, "New Task" %>

<div class="min-h-screen bg-slate-950 px-6 py-12 text-slate-100">
  <div class="mx-auto max-w-xl">

    <div class="mb-8">
      <h1 class="text-3xl font-bold text-white">
        Create a New Task
      </h1>

      <p class="mt-2 text-slate-400">
        Add a task and keep track of your progress.
      </p>
    </div>

    <div class="rounded-2xl border border-slate-800 bg-slate-900 p-8 shadow-lg">
      <%= render "form", task: @task %>
    </div>

    <div class="mt-6">
      <%= link_to "← Back to Tasks", tasks_path,
          class: "font-semibold text-sky-400 transition hover:text-sky-300" %>
    </div>

  </div>
</div>
