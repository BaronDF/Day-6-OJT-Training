
<% content_for :title, "Task Details" %>

<div class="min-h-screen bg-slate-950 px-6 py-12 text-slate-100">
  <div class="mx-auto max-w-3xl">

    <!-- Page Heading -->
    <div class="mb-8">
      <p class="mb-2 text-sm font-semibold uppercase tracking-wider text-sky-400">
        Task Details
      </p>

      <h1 class="text-3xl font-bold text-white">
        <%= @task.title %>
      </h1>

      <p class="mt-2 text-slate-400">
        View the details and progress of your task.
      </p>
    </div>

    <!-- Task Information Card -->
    <div class="rounded-2xl border border-slate-800 bg-slate-900 p-8 shadow-lg">

      <!-- Status -->
      <div class="mb-8">
        <p class="mb-3 text-sm font-semibold text-slate-400">
          STATUS
        </p>

        <% if @task.completed %>
          <span class="inline-flex rounded-full bg-green-900 px-4 py-2 text-sm font-semibold text-green-300">
            Completed
          </span>
        <% else %>
          <span class="inline-flex rounded-full bg-yellow-900 px-4 py-2 text-sm font-semibold text-yellow-300">
            In Progress
          </span>
        <% end %>
      </div>
      
<!-- Category -->
<div class="mb-8 border-t border-slate-800 pt-6">
  <h2 class="mb-3 text-lg font-bold text-white">
    Category
  </h2>

  <span class="inline-flex rounded-full bg-sky-900 px-4 py-2 text-sm font-semibold text-sky-300">
    <%= @task.category&.name || "Uncategorized" %>
  </span>
</div>

      <!-- Description -->
      <div class="border-t border-slate-800 pt-6">
        <h2 class="mb-3 text-lg font-bold text-white">
          Description
        </h2>

        <p class="whitespace-pre-wrap leading-relaxed text-slate-300">
          <%= @task.description.presence || "No description provided." %>
        </p>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-wrap gap-x-8 gap-y-4 border-t border-slate-800"
     style="margin-top: 40px; padding-top: 30px;">

        <%= link_to "Edit Task", edit_task_path(@task),
            class: "rounded-lg bg-sky-600 px-5 py-3 font-semibold text-white transition hover:bg-sky-500" %>

        <%= link_to "Back to Tasks", tasks_path,
            class: "rounded-lg border border-slate-700 px-5 py-3 font-semibold text-slate-300 transition hover:bg-slate-800" %>

        <%= button_to "Delete Task", @task,
    method: :delete,
    form: { onsubmit: "return confirm('Are you sure you want to delete this task?');" },
    class: "cursor-pointer rounded-lg bg-red-900 px-8 py-3 font-semibold text-red-200 transition hover:bg-red-800" %>

      </div>

    </div>
  </div>
</div>
