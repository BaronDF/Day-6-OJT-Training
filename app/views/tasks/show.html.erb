
<% content_for :title, "Task Details" %>

<div class="min-h-screen bg-slate-950 px-4 py-10 text-slate-100 sm:px-6">
  <div class="mx-auto max-w-3xl">

    <!-- Page Header -->
    <div class="mb-6">
      <%= link_to "← Back to Tasks", tasks_path,
          class: "mb-5 inline-flex text-sm font-medium text-sky-400 transition hover:text-sky-300" %>

      <p class="mb-2 text-xs font-bold uppercase tracking-[0.2em] text-sky-400">
        Task Details
      </p>

      <h1 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        <%= @task.title %>
      </h1>

      <p class="mt-2 text-sm text-slate-400">
        View your task information and additional details.
      </p>
    </div>

    <!-- Main Card -->
    <div class="overflow-hidden rounded-2xl border border-slate-800 bg-slate-900 shadow-xl">

      <div class="space-y-7 p-5 sm:p-8">

        <!-- Status and Category -->
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">

          <div class="rounded-xl border border-slate-800 bg-slate-950/60 p-4">
            <p class="mb-3 text-xs font-bold uppercase tracking-wider text-slate-500">
              Status
            </p>

            <% if @task.completed %>
              <span class="inline-flex items-center gap-2 rounded-full bg-green-500/10 px-3 py-1.5 text-sm font-semibold text-green-400">
                <span class="h-2 w-2 rounded-full bg-green-400"></span>
                Completed
              </span>
            <% else %>
              <span class="inline-flex items-center gap-2 rounded-full bg-yellow-500/10 px-3 py-1.5 text-sm font-semibold text-yellow-400">
                <span class="h-2 w-2 rounded-full bg-yellow-400"></span>
                In Progress
              </span>
            <% end %>
          </div>

          <div class="rounded-xl border border-slate-800 bg-slate-950/60 p-4">
            <p class="mb-3 text-xs font-bold uppercase tracking-wider text-slate-500">
              Category
            </p>

            <span class="inline-flex rounded-full bg-sky-500/10 px-3 py-1.5 text-sm font-semibold text-sky-400">
              <%= @task.category&.name || "Uncategorized" %>
            </span>
          </div>

        </div>

        <!-- Description -->
        <section>
          <h2 class="mb-3 text-sm font-bold uppercase tracking-wider text-slate-400">
            Description
          </h2>

          <div class="rounded-xl border border-slate-800 bg-slate-950/60 p-5">
            <p class="whitespace-pre-wrap text-sm leading-7 text-slate-300">
              <%= @task.description.presence || "No description provided." %>
            </p>
          </div>
        </section>

        <!-- Additional Task Details -->
        <section>
          <div class="mb-3 flex items-center justify-between">
            <h2 class="text-sm font-bold uppercase tracking-wider text-slate-400">
              Additional Task Details
            </h2>

            <span class="rounded-full bg-slate-800 px-2.5 py-1 text-xs font-medium text-slate-400">
              <%= @task.task_details.size %>
            </span>
          </div>

          <% if @task.task_details.any? %>
            <div class="space-y-3">
              <% @task.task_details.each_with_index do |detail, index| %>
                <div class="flex gap-3 rounded-xl border border-slate-800 bg-slate-950/60 p-4 transition hover:border-slate-700">

                  <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-sky-500/10 text-xs font-bold text-sky-400">
                    <%= index + 1 %>
                  </div>

                  <p class="min-w-0 whitespace-pre-wrap pt-1 text-sm leading-6 text-slate-300">
                    <%= detail.description %>
                  </p>

                </div>
              <% end %>
            </div>
          <% else %>
            <div class="rounded-xl border border-dashed border-slate-700 bg-slate-950/40 px-4 py-6 text-center">
              <p class="text-sm text-slate-500">
                No additional details provided yet.
              </p>
            </div>
          <% end %>
        </section>

      </div>

      <!-- Action Buttons -->
      <div class="flex flex-col gap-3 border-t border-slate-800 bg-slate-950/40 p-5 sm:flex-row sm:p-6">

        <%= link_to "Edit Task", edit_task_path(@task),
            class: "inline-flex items-center justify-center rounded-lg bg-sky-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-sky-500" %>

        <%= link_to "Back to Tasks", tasks_path,
            class: "inline-flex items-center justify-center rounded-lg border border-slate-700 px-5 py-3 text-sm font-semibold text-slate-300 transition hover:border-slate-600 hover:bg-slate-800" %>

        <%= button_to "Delete Task", @task,
            method: :delete,
            form: {
              class: "sm:ml-auto",
              onsubmit: "return confirm('Are you sure you want to delete this task?');"
            },
            class: "w-full cursor-pointer rounded-lg bg-red-500/10 px-5 py-3 text-sm font-semibold text-red-400 transition hover:bg-red-500/20 sm:w-auto" %>

      </div>

    </div>
  </div>
</div>
